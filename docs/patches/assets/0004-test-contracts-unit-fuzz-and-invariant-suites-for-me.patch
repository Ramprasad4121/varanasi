@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.26;
+
+import "forge-std/Test.sol";
+import {GoldToken} from "../../src/gold/GoldToken.sol";
+import {GoldRegistry} from "../../src/gold/GoldRegistry.sol";
+import {BankGoldIssuer} from "../../src/gold/BankGoldIssuer.sol";
+import {MetalToken} from "../../src/assets/MetalToken.sol";
+import {MetalCertificateRegistry} from "../../src/assets/MetalCertificateRegistry.sol";
+import {BankMetalIssuer} from "../../src/assets/BankMetalIssuer.sol";
+import {AssetRegistry} from "../../src/assets/AssetRegistry.sol";
+import {PledgeReceipt} from "../../src/assets/PledgeReceipt.sol";
+import {PledgeLoan} from "../../src/assets/PledgeLoan.sol";
+import {BankAssetDesk} from "../../src/assets/BankAssetDesk.sol";
+import {MockRupee} from "../../src/app/MockRupee.sol";
+
+/// Shared deployment for the multi-asset suites: gold (existing), silver and
+/// platinum (BankMetalIssuer), the asset registry, pledge receipts, the pledge
+/// loan book and the bank asset desk. Bank keys are mock keys.
+abstract contract AssetsBase is Test {
+    address gov = makeAddr("governance");
+    address bankOps = makeAddr("bank-ops");
+    address bank2Ops = makeAddr("bank2-ops");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+    address rogue = makeAddr("rogue");
+    address buyerA = makeAddr("buyer-a");
+    address buyerB = makeAddr("buyer-b");
+
+    uint256 bankKey = 0xB4A1C;
+    uint256 bank2Key = 0xB4A2C;
+    address bankSigner;
+    address bank2Signer;
+
+    bytes32 constant BANK = keccak256("MOCK-BANK-1");
+    bytes32 constant BANK2 = keccak256("MOCK-BANK-2");
+    bytes32 constant XAU = "XAU";
+    bytes32 constant XAG = "XAG";
+    bytes32 constant XPT = "XPT";
+    uint256 constant MG = 1e15;
+
+    GoldToken gold;
+    GoldRegistry goldReg;
+    BankGoldIssuer goldIssuer;
+    MetalToken silver;
+    BankMetalIssuer silverIssuer;
+    MetalToken platinum;
+    BankMetalIssuer platinumIssuer;
+    AssetRegistry assets;
+
+    PledgeReceipt receipts;
+    PledgeLoan loans;
+    BankAssetDesk desk;
+    MockRupee rupee;
+
+    uint256 nonceSeq;
+
+    function _deployMetals() internal {
+        bankSigner = vm.addr(bankKey);
+        bank2Signer = vm.addr(bank2Key);
+        gold = new GoldToken(address(0));
+        goldReg = new GoldRegistry();
+        goldIssuer = new BankGoldIssuer(gov, address(gold), address(goldReg), address(0));
+        gold.bindIssuer(address(goldIssuer));
+        goldReg.bindIssuer(address(goldIssuer));
+
+        (silver, silverIssuer) = _newMetal("Varanasi Silver", "vSILVER", XAG, 999);
+        (platinum, platinumIssuer) = _newMetal("Varanasi Platinum", "vPLAT", XPT, 950);
+
+        vm.startPrank(gov);
+        goldIssuer.addBank(BANK, "Mock Bank 1", bankSigner, bankOps);
+        silverIssuer.addBank(BANK, "Mock Bank 1", bankSigner, bankOps);
+        silverIssuer.addBank(BANK2, "Mock Bank 2", bank2Signer, bank2Ops);
+        platinumIssuer.addBank(BANK, "Mock Bank 1", bankSigner, bankOps);
+        assets = new AssetRegistry(gov);
+        assets.listMetal(XAU, "Gold", address(gold), address(goldIssuer));
+        assets.listMetal(XAG, "Silver", address(silver), address(silverIssuer));
+        assets.listMetal(XPT, "Platinum", address(platinum), address(platinumIssuer));
+        vm.stopPrank();
+    }
+
+    function _newMetal(string memory name, string memory symbol, bytes32 code, uint16 minPurity)
+        internal
+        returns (MetalToken t, BankMetalIssuer i)
+    {
+        t = new MetalToken(name, symbol, address(0));
+        MetalCertificateRegistry r = new MetalCertificateRegistry();
+        i = new BankMetalIssuer(gov, address(t), address(r), address(0), code, name, minPurity);
+        t.bindIssuer(address(i));
+        r.bindIssuer(address(i));
+    }
+
+    function _metalAtt(bytes32 bankId, address user, bytes32 cert, uint256 fineMilli, uint256 purity)
+        internal
+        returns (BankMetalIssuer.BankAttestation memory a)
+    {
+        a = BankMetalIssuer.BankAttestation({
+            bankId: bankId,
+            user: user,
+            certificateId: cert,
+            fineGramsMilli: fineMilli,
+            purityPermille: purity,
+            nonce: ++nonceSeq,
+            expiry: block.timestamp + 1 days
+        });
+    }
+
+    function _signMetal(BankMetalIssuer issuer, uint256 key, BankMetalIssuer.BankAttestation memory a)
+        internal
+        view
+        returns (bytes memory)
+    {
+        (uint8 v, bytes32 r, bytes32 s) = vm.sign(key, issuer.hashAttestation(a));
+        return abi.encodePacked(r, s, v);
+    }
+
+    function _mintMetal(BankMetalIssuer issuer, address user, uint256 fineMilli) internal returns (bytes32 cert) {
+        cert = keccak256(abi.encode(address(issuer), "cert", nonceSeq + 1));
+        BankMetalIssuer.BankAttestation memory a = _metalAtt(BANK, user, cert, fineMilli, 999);
+        issuer.mint(a, _signMetal(issuer, bankKey, a));
+    }
+
+    // ---------------------------------------------------------------- pledge
+    function _deployPledge() internal {
+        if (bankSigner == address(0)) {
+            bankSigner = vm.addr(bankKey);
+            bank2Signer = vm.addr(bank2Key);
+        }
+        vm.startPrank(gov);
+        receipts = new PledgeReceipt(gov);
+        rupee = new MockRupee(gov, address(0));
+        loans = new PledgeLoan(gov, address(receipts), address(rupee));
+        desk = new BankAssetDesk(gov, address(receipts), address(rupee));
+        receipts.addBank(BANK, "Mock Bank 1", bankSigner, bankOps);
+        receipts.addBank(BANK2, "Mock Bank 2", bank2Signer, bank2Ops);
+        receipts.setLienMover(address(loans), true);
+        receipts.setLienMover(address(desk), true);
+        desk.setApprovedBuyer(buyerA, true);
+        desk.setApprovedBuyer(buyerB, true);
+        desk.setApprovedBuyer(bank2Ops, true);
+        rupee.mint(bankOps, 100_000_000_00);
+        rupee.mint(alice, 10_000_000_00);
+        rupee.mint(buyerA, 100_000_000_00);
+        rupee.mint(buyerB, 100_000_000_00);
+        rupee.mint(bank2Ops, 100_000_000_00);
+        vm.stopPrank();
+        vm.prank(bankOps);
+        rupee.approve(address(loans), type(uint256).max);
+        vm.prank(bankOps);
+        loans.fund(BANK, 50_000_000_00); // Rs 5 crore lending pot
+        for (uint256 i; i < 4; ++i) {
+            address who = [alice, buyerA, buyerB, bank2Ops][i];
+            vm.startPrank(who);
+            rupee.approve(address(loans), type(uint256).max);
+            rupee.approve(address(desk), type(uint256).max);
+            vm.stopPrank();
+        }
+    }
+
+    function _pledgeAtt(address holder, uint8 cls, uint256 paise, uint64 reappraiseBy)
+        internal
+        returns (PledgeReceipt.PledgeAttestation memory a)
+    {
+        uint256 n = ++nonceSeq;
+        a = PledgeReceipt.PledgeAttestation({
+            bankId: BANK,
+            holder: holder,
+            receiptRef: keccak256(abi.encode("pledge", n)),
+            assetClass: cls,
+            assetIdHash: keccak256(abi.encode("RC-TS09-hash", n)),
+            detailsHash: keccak256(abi.encode("appraisal-file", n)),
+            appraisedPaise: paise,
+            appraisedAt: uint64(block.timestamp),
+            reappraiseBy: reappraiseBy,
+            nonce: n,
+            expiry: block.timestamp + 1 days
+        });
+    }
+
+    function _signPledge(uint256 key, PledgeReceipt.PledgeAttestation memory a) internal view returns (bytes memory) {
+        (uint8 v, bytes32 r, bytes32 s) = vm.sign(key, receipts.hashAttestation(a));
+        return abi.encodePacked(r, s, v);
+    }
+
+    /// Issue a receipt for a Rs 6 lakh car (class 0) valid for a year.
+    function _issueCar(address holder) internal returns (uint256 id) {
+        PledgeReceipt.PledgeAttestation memory a =
+            _pledgeAtt(holder, 0, 6_00_000_00, uint64(block.timestamp + 365 days));
+        id = receipts.issue(a, _signPledge(bankKey, a));
+    }
+}
diff --git a/contracts/test/assets/AssetsInvariant.t.sol b/contracts/test/assets/AssetsInvariant.t.sol
new file mode 100644
index 0000000..c73f592
--- /dev/null
+++ b/contracts/test/assets/AssetsInvariant.t.sol
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.26;
+
+import "./AssetsBase.sol";
+
+/// Random sequences of metal deposits, redemptions, bank releases and transfers
+/// across silver and platinum.
+contract MetalHandler is AssetsBase {
+    BankMetalIssuer[2] public issuers;
+    MetalToken[2] public tokens;
+    address[3] internal users;
+    uint256[] internal pendingIds;
+    uint256[] internal pendingIssuer;
+
+    constructor(BankMetalIssuer s, BankMetalIssuer p, MetalToken st, MetalToken pt, uint256 key, address ops) {
+        issuers = [s, p];
+        tokens = [st, pt];
+        bankKey = key;
+        bankOps = ops;
+        users = [makeAddr("u1"), makeAddr("u2"), makeAddr("u3")];
+    }
+
+    function deposit(uint256 which, uint256 user, uint64 fine) external {
+        BankMetalIssuer i = issuers[which % 2];
+        fine = uint64(bound(fine, 1, 1e9));
+        BankMetalIssuer.BankAttestation memory a =
+            _metalAtt(BANK, users[user % 3], keccak256(abi.encode("inv", nonceSeq + 1)), fine, 999);
+        i.mint(a, _signMetal(i, bankKey, a));
+    }
+
+    function redeem(uint256 which, uint256 user, uint256 amt) external {
+        uint256 w = which % 2;
+        address u = users[user % 3];
+        uint256 bal = tokens[w].balanceOf(u) / MG;
+        if (bal == 0) return;
+        amt = bound(amt, 1, bal);
+        vm.prank(u);
+        uint256 id = issuers[w].requestRedemption(BANK, amt, "inv");
+        pendingIds.push(id);
+        pendingIssuer.push(w);
+    }
+
+    function fulfil(uint256 k) external {
+        if (pendingIds.length == 0) return;
+        k = k % pendingIds.length;
+        uint256 id = pendingIds[k];
+        BankMetalIssuer i = issuers[pendingIssuer[k]];
+        pendingIds[k] = pendingIds[pendingIds.length - 1];
+        pendingIds.pop();
+        pendingIssuer[k] = pendingIssuer[pendingIssuer.length - 1];
+        pendingIssuer.pop();
+        vm.prank(bankOps);
+        if (uint256(keccak256(abi.encode(id))) % 2 == 0) i.fulfilRedemption(id, "r");
+        else i.cancelRedemption(id, "c");
+    }
+
+    function transfer(uint256 which, uint256 from, uint256 to, uint256 amt) external {
+        MetalToken t = tokens[which % 2];
+        address f = users[from % 3];
+        uint256 bal = t.balanceOf(f);
+        if (bal == 0) return;
+        vm.prank(f);
+        t.transfer(users[to % 3], bound(amt, 0, bal));
+    }
+}
+
+contract MetalInvariantTest is AssetsBase {
+    MetalHandler handler;
+
+    function setUp() public {
+        _deployMetals();
+        handler = new MetalHandler(silverIssuer, platinumIssuer, silver, platinum, bankKey, bankOps);
+        targetContract(address(handler));
+    }
+
+    function _check(BankMetalIssuer i, MetalToken t) internal view {
+        (uint256 supply, uint256 attested, uint256 pending, uint256 disputed, bool ok) = i.proofOfReserve();
+        assertTrue(ok, "fully backed");
+        assertLe(supply + pending + disputed, attested, "supply <= attested reserve");
+        assertEq(t.totalSupply() % MG, 0, "whole milligrams only");
+    }
+
+    function invariant_perMetalSupplyWithinReserve() public view {
+        _check(silverIssuer, silver);
+        _check(platinumIssuer, platinum);
+    }
+
+    function invariant_goldUntouchedByOtherMetals() public view {
+        assertEq(gold.totalSupply(), 0);
+    }
+}
+
+/// Random loans, defaults, listings, bids, redemptions and settlements.
+contract DeskHandler is AssetsBase {
+    uint256[] public openLoans;
+    uint256[] public liveListings;
+    uint256 public movedBeforeWindow; // must stay 0
+    uint256 public unapprovedBidAccepted; // must stay 0
+    uint256 public ghostSettled;
+    uint256 public ghostRedeemed;
+
+    constructor(
+        PledgeReceipt r,
+        PledgeLoan l,
+        BankAssetDesk d,
+        MockRupee m,
+        uint256 key,
+        address ops,
+        address a,
+        address ba,
+        address bb
+    ) {
+        receipts = r;
+        loans = l;
+        desk = d;
+        rupee = m;
+        bankKey = key;
+        bankOps = ops;
+        alice = a;
+        buyerA = ba;
+        buyerB = bb;
+    }
+
+    function borrow(uint256 paise, uint8 cls) external {
+        cls = uint8(bound(cls, 0, 4));
+        PledgeReceipt.PledgeAttestation memory a =
+            _pledgeAtt(alice, cls, 6_00_000_00, uint64(block.timestamp + 365 days));
+        uint256 id = receipts.issue(a, _signPledge(bankKey, a));
+        uint256 maxP = loans.maxBorrowPaise(id);
+        paise = bound(paise, 1, maxP);
+        if (paise > loans.liquidityOf(BANK)) return;
+        vm.startPrank(alice);
+        receipts.approve(address(loans), id);
+        openLoans.push(loans.borrow(id, paise, uint64(block.timestamp + 10 days)));
+        vm.stopPrank();
+    }
+
+    function repay(uint256 k) external {
+        if (openLoans.length == 0) return;
+        k = k % openLoans.length;
+        uint256 loanId = openLoans[k];
+        _dropLoan(k);
+        vm.prank(alice);
+        loans.repay(loanId);
+    }
+
+    function defaultAndList(uint256 k, bool sealed_) external {
+        if (openLoans.length == 0) return;
+        k = k % openLoans.length;
+        uint256 loanId = openLoans[k];
+        (uint256 tokenId,,,,, uint64 dueAt,) = loans.loans(loanId);
+        if (block.timestamp <= dueAt) vm.warp(dueAt + 1);
+        _dropLoan(k);
+        vm.startPrank(bankOps);
+        loans.claimDefault(loanId);
+        receipts.approve(address(desk), tokenId);
+        uint64 bidEnd = uint64(block.timestamp + 5 days);
+        uint256 lid = desk.list(
+            tokenId,
+            sealed_ ? 1 : 0,
+            3,
+            1_00_000_00,
+            uint64(block.timestamp + 7 days),
+            bidEnd,
+            sealed_ ? bidEnd + 1 days : bidEnd,
+            alice,
+            50_000_00
+        );
+        vm.stopPrank();
+        liveListings.push(lid);
+    }
+
+    function bidEnglish(uint256 k, uint256 bump, bool useB) external {
+        if (liveListings.length == 0) return;
+        uint256 lid = liveListings[k % liveListings.length];
+        (,,, uint8 kind,, BankAssetDesk.Status st,, uint64 bidEnd,,,,,) = desk.listings(lid);
+        if (kind != 0 || st != BankAssetDesk.Status.LISTED || block.timestamp > bidEnd) return;
+        uint256 amt = desk.minimumBid(lid) + bound(bump, 0, 1_00_000_00);
+        vm.prank(useB ? buyerB : buyerA);
+        desk.bid(lid, amt);
+    }
+
+    function bidStranger(uint256 k) external {
+        if (liveListings.length == 0) return;
+        uint256 lid = liveListings[k % liveListings.length];
+        vm.prank(makeAddr("stranger"));
+        try desk.bid(lid, 10_00_000_00) {
+            unapprovedBidAccepted++;
+        } catch {}
+    }
+
+    function commitSealed(uint256 k, uint256 amt, bool useB) external {
+        if (liveListings.length == 0) return;
+        uint256 lid = liveListings[k % liveListings.length];
+        (,,, uint8 kind,, BankAssetDesk.Status st,, uint64 bidEnd,,,,,) = desk.listings(lid);
+        if (kind != 1 || st != BankAssetDesk.Status.LISTED || block.timestamp > bidEnd) return;
+        address who = useB ? buyerB : buyerA;
+        if (desk.commitmentOf(lid, who) != bytes32(0)) return;
+        amt = bound(amt, 1_00_000_00, 5_00_000_00);
+        vm.prank(who);
+        desk.commitBid(lid, keccak256(abi.encode(lid, who, amt, bytes32("s"))), amt);
+    }
+
+    function revealSealed(uint256 k, uint256 amt, bool useB) external {
+        if (liveListings.length == 0) return;
+        uint256 lid = liveListings[k % liveListings.length];
+        address who = useB ? buyerB : buyerA;
+        amt = bound(amt, 1_00_000_00, 5_00_000_00);
+        vm.prank(who);
+        try desk.revealBid(lid, amt, bytes32("s")) {} catch {}
+    }
+
+    function redeem(uint256 k) external {
+        if (liveListings.length == 0) return;
+        uint256 lid = liveListings[k % liveListings.length];
+        vm.prank(alice);
+        try desk.redeem(lid) {
+            ghostRedeemed++;
+        } catch {}
+    }
+
+    function settle(uint256 k) external {
+        if (liveListings.length == 0) return;
+        uint256 lid = liveListings[k % liveListings.length];
+        (,,,,,, uint64 win,,,,,,) = desk.listings(lid);
+        bool early = block.timestamp <= win;
+        vm.prank(bankOps);
+        try desk.settle(lid, 1_00_000_00, uint64(block.timestamp + 30 days)) {
+            ghostSettled++;
+            if (early) movedBeforeWindow++;
+        } catch {}
+    }
+
+    function reclaim(uint256 k, bool useB) external {
+        if (liveListings.length == 0) return;
+        uint256 lid = liveListings[k % liveListings.length];
+        vm.prank(useB ? buyerB : buyerA);
+        try desk.reclaimDeposit(lid) {} catch {}
+    }
+
+    function withdraw(bool useB) external {
+        address who = useB ? buyerB : buyerA;
+        if (desk.credit(who) == 0) return;
+        vm.prank(who);
+        desk.withdraw();
+    }
+
+    function warp(uint32 dt) external {
+        vm.warp(block.timestamp + bound(dt, 1 hours, 3 days));
+    }
+
+    function _dropLoan(uint256 k) internal {
+        openLoans[k] = openLoans[openLoans.length - 1];
+        openLoans.pop();
+    }
+
+    function listingCountLive() external view returns (uint256) {
+        return liveListings.length;
+    }
+
+    function liveListingAt(uint256 i) external view returns (uint256) {
+        return liveListings[i];
+    }
+}
+
+contract DeskInvariantTest is AssetsBase {
+    DeskHandler handler;
+
+    function setUp() public {
+        _deployPledge();
+        handler = new DeskHandler(receipts, loans, desk, rupee, bankKey, bankOps, alice, buyerA, buyerB);
+        targetContract(address(handler));
+    }
+
+    function invariant_deskEscrowFullyCovered() public view {
+        assertEq(rupee.balanceOf(address(desk)), desk.totalEscrow() + desk.totalCredit());
+    }
+
+    function afterInvariant() public view {
+        console.log("settled", handler.ghostSettled(), "redeemed", handler.ghostRedeemed());
+    }
+
+    function invariant_loanBookSolvent() public view {
+        assertEq(rupee.balanceOf(address(loans)), loans.totalLiquidity());
+    }
+
+    function invariant_noTransferBeforeWindow_andOnlyApprovedBidders() public view {
+        assertEq(handler.movedBeforeWindow(), 0);
+        assertEq(handler.unapprovedBidAccepted(), 0);
+        for (uint256 i; i < handler.listingCountLive(); ++i) {
+            uint256 lid = handler.liveListingAt(i);
+            (uint256 tokenId,,,,, BankAssetDesk.Status st,,,,,,,) = desk.listings(lid);
+            if (st == BankAssetDesk.Status.LISTED) {
+                assertEq(receipts.ownerOf(tokenId), address(desk), "receipt stays at desk until window ends");
+            }
+        }
+    }
+}
diff --git a/contracts/test/assets/BankAssetDesk.t.sol b/contracts/test/assets/BankAssetDesk.t.sol
