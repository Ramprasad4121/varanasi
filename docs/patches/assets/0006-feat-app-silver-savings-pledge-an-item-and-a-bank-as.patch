diff --git a/app/lib/api.ts b/app/lib/api.ts
index 7cd2bfe..9dc5cbe 100644
--- a/app/lib/api.ts
+++ b/app/lib/api.ts
@@ -119,7 +119,8 @@ const publicDemo: Backend = {
