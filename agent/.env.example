# ── The Graph (live Gateway; required for default path) ──
GRAPH_API_KEY=
# Optional overrides for curated subgraph IDs (defaults are standardized-schema IDs below)
# GRAPH_UNISWAP_V3_ID=

# ── Sepolia / ENSv2 identity ──
SEPOLIA_RPC_URL=https://rpc.sepolia.org
AEGIS_REGISTRY=
RISK_GUARD=
# Universal Resolver V2 (Sepolia ENSv2 beta default; override if redeployed)
# ENSV2_UNIVERSAL_RESOLVER=0x4a1817D13E9cF196F471725176355C1234b63C70

# ── Hedera x402 payer (agent pays service//v1/signal) ──
HEDERA_NETWORK=testnet
HEDERA_AGENT_ACCOUNT_ID=0.0.XXXX
HEDERA_AGENT_PRIVATE_KEY=302e020100300506032b657004220420...
SIGNAL_URL=http://localhost:4021/v1/signal

# ── Reasoning knobs ──
# RISK_THRESHOLD_BPS=5000

# ── LLM reasoning (opt-in via --llm; local LM Studio default, no key needed) ──
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# LLM_MODEL=local-model

# ── TypeSafe verifier gate (SDE-cascade style; auto-on only when key present) ──
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.12
# TYPESAFE_VERIFY=auto
# TYPESAFE_VERIFY_THRESHOLD=0.7
