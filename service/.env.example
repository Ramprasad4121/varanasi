# --- AEGIS signal service: receiver wallet (gets paid) ---
# ECDSA account from https://portal.hedera.com (testnet). This account
# RECEIVES the USDC/HBAR from every paid /v1/signal + /v1/score call.
HEDERA_SERVICE_ACCOUNT_ID=0.0.XXXXXX
# Private key is only needed for local tooling (e.g. token association).
# The service NEVER signs with it at runtime — the facilitator settles.
HEDERA_SERVICE_PRIVATE_KEY=0x...

# --- Network ---
# testnet (default) or mainnet. Mainnet receiver must be a mainnet account.
HEDERA_NETWORK=testnet

# --- Facilitator (payment verifier/settler) ---
# Default when unset: https://x402.org/facilitator (testnet),
# https://api.blocky402.com (mainnet).
# Override with EITHER of these:
X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_TESTNET_FACILITATOR_URL=https://api.testnet.blocky402.com
# X402_MAINNET_FACILITATOR_URL=https://api.blocky402.com

# --- HTTP ---
PORT=4021
# Comma-separated CORS allowlist, e.g. CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Unset: open `*` in non-production (with a startup warning); same-origin only in production.
CORS_ORIGIN=
# NODE_ENV=production disables the open-`*` CORS default (same-origin only unless CORS_ORIGIN set).
# NODE_ENV=development

# --- HCS payment audit trail (Hedera track) ---
# Best-effort mirror of every paid receipt to a Hedera Consensus Service topic
# (src/hcs.ts). Set to 0 to disable.
HCS_ENABLED=1
# Optional: reuse an existing topic. When empty, the service auto-creates one
# topic with the operator key on the first paid request and prints the id —
# persist the printed id here to avoid a create-tx on every restart.
HCS_TOPIC_ID=
# NOTE: unlike the x402 settlement path (facilitator signs), the HCS trail IS
# signed by this service, so HCS_ENABLED=1 requires HEDERA_SERVICE_PRIVATE_KEY
# above to be the operator's real ECDSA key. Keys are never printed or logged.
