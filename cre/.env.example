# Local simulation values for the Vault DON secrets (see secrets.yaml).
# Copy to .env and fill in. NEVER commit .env (repo .gitignore covers it).
# Any values work for simulation; production values live in the Vault DON.

# ── Pool-risk workflow ────────────────────────────────────────
# Private ACT/SKIP cutoff in bps (0..10000). Default AEGIS heuristic: 5000.
SECRET_RISK_THRESHOLD_BPS=5000

# Private per-factor multipliers (JSON). Lets the operator tune sensitivity
# without revealing the strategy to node operators.
SECRET_STRATEGY_WEIGHTS={"liquidity":1,"activity":1,"alpha":1}

# Private roster of approved agent wallets (JSON array).
SECRET_OPERATOR_ALLOWLIST=["0xAgent000000000000000000000000000000000001"]

# Credential the enclave uses to POST verdicts to the Aegis agent API.
SECRET_AEGIS_API_KEY=dev-only-not-a-real-key

# ── Verdict-network workflow ──────────────────────────────────
# Private APPROVE bar in bps (high = good). Match the MandateTreeEscrow
# per-task `pinnedThresholdBps` you want this committee to enforce.
SECRET_VERDICT_QUALITY_BAR_BPS=8000

# Private per-factor multipliers (JSON), tunable without revealing the rubric.
SECRET_VERDICT_RUBRIC_WEIGHTS={"completeness":1,"timeliness":1,"budget":1}

# Private roster of authorized verdict-node addresses (JSON array).
SECRET_VERDICT_NODE_ROSTER=["0xNode0000000000000000000000000000000000001"]