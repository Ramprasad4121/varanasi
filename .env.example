# Varanasi people app: example settings. Copy to .env and fill in only what you need.
# No real secrets belong in this file or in git. The local demo needs NONE of these.

# --- mode ---
# empty or public = browser test ledger (the hosted demo, the default);
# local = the local chain demo (scripts/app-demo.sh sets this for you)
NEXT_PUBLIC_VARANASI_MODE=

# --- waitlist (public demo) ---
# Upstash Redis REST. Either name pair works (Vercel's Upstash integration sets KV_*).
# Without one of them a hosted waitlist does not persist.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# token for GET /api/waitlist (team only, at least 16 characters)
WAITLIST_ADMIN_TOKEN=
# signs weekly update unsubscribe links (at least 16 characters, server only)
WAITLIST_UNSUB_SECRET=

# --- error monitoring (optional, stubbed; nothing is sent unless set) ---
# any endpoint that accepts a JSON POST of {message, stack, where, at}
ERROR_WEBHOOK_URL=

# --- local demo ports ---
APP_PORT=3100
CHAIN_PORT=18645
