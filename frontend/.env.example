# Copy to .env.local for local dev. Never commit real keys.
NEXT_PUBLIC_SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_KEY
NEXT_PUBLIC_AEGIS_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SIGNAL_URL=https://your-x402-signal-service.example/v1/signal
# --- Live Uniswap subgraph reads (Pool intel → Refresh onchain data).
# Get this from thegraph.com/studio → your API key.
NEXT_PUBLIC_GRAPH_API_KEY=
# --- Site-wide sign-in (nav + /account + /privy + hire). From dashboard.privy.io.
# Email / Google / GitHub / wallet. Creates an embedded Sepolia wallet on first login.
NEXT_PUBLIC_PRIVY_APP_ID=
# --- Inventions rail (proof table rows appear once set; empty = hidden).
# Deployed via contracts/script/DeployInventions.s.sol.
NEXT_PUBLIC_AKSHAYA=
NEXT_PUBLIC_GHAT_STREAM=
