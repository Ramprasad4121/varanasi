# Copy to .env.local for local dev. Never commit real keys.
NEXT_PUBLIC_SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_KEY
NEXT_PUBLIC_AEGIS_REGISTRY=0x0000000000000000000000000000000000000000
# Signal service base URL. Local dev: http://localhost:4021
# Production (recommended): /api/backend — same-origin proxy, no CORS config needed
# (see next.config.js rewrites; set service CORS_ORIGIN to your site origin anyway).
# Direct host also works: https://your-x402-signal-service.example
NEXT_PUBLIC_SIGNAL_URL=http://localhost:4021
# --- Live Uniswap subgraph reads (Pool intel → Refresh onchain data).
# Get this from thegraph.com/studio → your API key.
NEXT_PUBLIC_GRAPH_API_KEY=
# --- Site-wide sign-in (nav + /account + /privy + hire). From dashboard.privy.io.
# Email / Google / GitHub / wallet. Creates an embedded Sepolia wallet on first login.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only. Allowlisted TaskEscrow validator (Sepolia). Empty = POST /api/v1/attest returns 503.
# Never prefix with NEXT_PUBLIC_. Never commit the value.
SEPOLIA_VALIDATOR_KEY=
SEPOLIA_RPC_URL=
